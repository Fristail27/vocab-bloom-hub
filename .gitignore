# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.yarn

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


# dependencies
/apps/frontend/node_modules
/apps/frontend/.pnp
/apps/frontend/.pnp.*
/apps/frontend/.yarn/*
!/apps/frontend/.yarn/patches
!/apps/frontend/.yarn/plugins
!/apps/frontend/.yarn/releases
!/apps/frontend/.yarn/versions
/apps/server/node_modules
/node_modules

# next.js
/apps/frontend/.next/
/apps/site/.next/
/apps/frontend/out/
/apps/site/out/

# production
/apps/frontend/build
/apps/server/dist
/packages/*/dist

# python-sdk
/packages/python-sdk/.venv
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
/apps/server/build

# misc
.DS_Store
*.pem
/apps/frontend/.DS_Store
/apps/frontend/*.pem
/apps/server/.DS_Store
/apps/server/*.pem

# debug
/apps/frontend/npm-debug.log*
/apps/frontend/yarn-debug.log*
/apps/frontend/yarn-error.log*
/apps/frontend/.pnpm-debug.log*
/apps/server/npm-debug.log*
/apps/server/yarn-debug.log*
/apps/server/yarn-error.log*
/apps/server/.pnpm-debug.log*

# datasets dropped in for docker compose (mounted as DICTIONARY_IMPORT_DIR)
/imports/

# env files (can opt-in for committing if needed)
/apps/frontend/.env*
/apps/server/.env*
.env*
!.env.example

# vercel
/apps/frontend/.vercel

# typescript
/apps/frontend/*.tsbuildinfo
/apps/frontend/next-env.d.ts
/apps/site/*.tsbuildinfo
/apps/site/next-env.d.ts

# Diagnostic reports (https://nodejs.org/api/report.html)
/apps/server/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

dev.sqlite

# generated on demand by `yarn workspace server openapi:generate`; only the public spec is committed
apps/server/openapi/admin.json
packages/npm-sdk/dist