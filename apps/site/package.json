{
  "name": "site",
  "version": "0.1.0-alpha.3",
  "private": true,
  "license": "MIT",
  "description": "Public website of Vocab Bloom Hub — documentation, the public API reference, SDK guides, a live playground and word pages, served next to a running instance (Next.js).",
  "author": {
    "name": "Alexey Ryzhov (Fristail27)",
    "url": "https://github.com/Fristail27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fristail27/vocab-bloom-hub.git"
  },
  "scripts": {
    "dev": "dotenv -e \"${ENV_FILE:-../../.env}\" -- next dev -p \"${SITE_PORT:-3020}\"",
    "build": "NODE_ENV=production dotenv -e \"${ENV_FILE:-../../.env}\" -- next build",
    "start": "dotenv -e \"${ENV_FILE:-../../.env}\" -- next start -p \"${SITE_PORT:-3020}\"",
    "test": "jest"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "hast-util-to-string": "^3.0.1",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sass": "^1.102.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/identity-obj-proxy": "^3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "identity-obj-proxy": "^3.0.0",
    "typescript": "^7.0.2"
  }
}
