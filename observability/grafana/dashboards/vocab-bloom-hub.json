{
  "uid": "vocab-bloom-hub",
  "title": "Vocab Bloom Hub",
  "description": "The server's Prometheus metrics (docs/observability.md): HTTP by route, search tiers, dictionary size and transfers, Postgres pool, process health.",
  "tags": ["vocab-bloom-hub"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx share) by route",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{status=~\"5..\"}[$__rate_interval])) / sum by (route) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total request rate",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total[$__rate_interval]))", "legendFormat": "requests" }
      ]
    },
    {
      "type": "stat",
      "title": "Requests in flight",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "http_requests_in_flight", "legendFormat": "in flight" }]
    },
    {
      "type": "timeseries",
      "title": "Search tier hits",
      "description": "Which tier produced the top answer (issues #278, #292): a growing fuzzy share means typos beyond the substring tiers, a large none share means the dictionary lacks what users look for.",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tier) (rate(vbh_search_tier_hits_total[$__rate_interval]))",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Fuzzy share (1h)",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vbh_search_tier_hits_total{tier=\"fuzzy\"}[1h])) / sum(rate(vbh_search_tier_hits_total[1h]))",
          "legendFormat": "fuzzy"
        }
      ]
    },
    {
      "type": "stat",
      "title": "No-result share (1h)",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vbh_search_tier_hits_total{tier=\"none\"}[1h])) / sum(rate(vbh_search_tier_hits_total[1h]))",
          "legendFormat": "none"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dictionary size by kind",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "vbh_dictionary_size", "legendFormat": "{{kind}}" }]
    },
    {
      "type": "timeseries",
      "title": "Import / export progress",
      "description": "Progress of the running transfer with its stage; flat at a value while in_progress is 1 = a stuck transfer.",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vbh_dictionary_transfer_progress_percent",
          "legendFormat": "{{kind}}: {{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transfers finished (1h windows)",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, result) (increase(vbh_dictionary_transfers_total[1h]))",
          "legendFormat": "{{kind}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Postgres pool",
      "description": "A sustained `waiting` count means requests queue for a connection: raise DB_POOL_SIZE (docs/environment.md). Absent on SQLite.",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "vbh_db_pool_connections", "legendFormat": "{{state}}" }]
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total[$__rate_interval])",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Resident memory",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "rss" }]
    },
    {
      "type": "timeseries",
      "title": "Event loop lag (p99)",
      "datasource": { "type": "prometheus", "uid": "vbh-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "p99" }]
    }
  ]
}
