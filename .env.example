# Copy to .env — one file for both apps (docs/environment.md lists every variable).
# The values below are what `docker compose up` needs; for a native start
# see docs/deployment/README.md.

# --- required -----------------------------------------------------------------
# The single admin account; long and random in any instance reachable by others
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- database -----------------------------------------------------------------
# docker compose ships a Postgres as the `db` profile: keep COMPOSE_PROFILES=db
# and the server uses it with the POSTGRES_* credentials below.
# For a database of your own: remove the COMPOSE_PROFILES line and set
# DATABASE_URL to it (a database on the Docker host is host.docker.internal,
# not localhost). Native start: any postgres:// URL (production) or
# sqlite:<path> (development only).
COMPOSE_PROFILES=db
POSTGRES_USER=vocab
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=vocab_bloom
# DATABASE_URL=postgres://user:password@host.docker.internal:5432/vocab_bloom

# --- URLs ---------------------------------------------------------------------
# What the browser opens; the reverse proxy serves both apps under it and routes
# /api/* to the server. Set it to the public https origin in a real deployment.
# Relative (/api) means "the same origin as the page" and needs no rebuild.
NEXT_PUBLIC_BASE_API_URL=/api
CORS_ORIGINS=http://localhost:3000
# Hops of reverse proxy in front of the server (docs/deployment/reverse-proxy.md)
TRUST_PROXY=1

# --- ports (compose publishes them on localhost only) -------------------------
SERVER_PORT=3010
FRONT_PORT=3000

# --- images (docker compose) --------------------------------------------------
# Tag of the published images: `main` (development builds, default until the
# first release), a release such as `0.1` or `0.1.0`, or `latest`
# VBH_TAG=main

# --- dictionary ---------------------------------------------------------------
# Load the published dictionary by itself on first start (empty instance):
# docker compose turns this on; for a native start set it here
# DICTIONARY_AUTO_IMPORT=true

# --- optional -----------------------------------------------------------------
NODE_ENV=production
# Seconds a graceful stop may take after SIGTERM (default 30)
# SHUTDOWN_TIMEOUT=30
# Prometheus metrics (docs/observability.md); keep the endpoint private
# METRICS_ENABLED=true
# Datasets the import page may load from the server (compose mounts ./imports there)
# DICTIONARY_IMPORT_DIR=/data/dictionary-imports
# Which API surfaces to serve, the public rate limit and cache max-age (defaults shown)
# PUBLIC_API_ENABLED=true
# ADMIN_API_ENABLED=true
# PUBLIC_API_RATE_LIMIT=100/60
# PUBLIC_API_CACHE_MAX_AGE=3600
# LOG_LEVEL=log
