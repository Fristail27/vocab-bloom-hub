# Build context for the Dockerfiles of apps/server, apps/frontend and
# apps/site (all built from the repository root). Everything not needed to
# install and build is left out: secrets, local databases, build outputs.
.git
.github
.husky
.vscode
.idea
node_modules
**/node_modules
**/dist
**/.next
**/coverage
**/.tmp
*.sqlite
*.sqlite-*
.env
.env.*
!.env.example
packages/python-sdk/.venv
packages/python-sdk/dist
apps/e2e/playwright-report
apps/e2e/test-results
*.log
