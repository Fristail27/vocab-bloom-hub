# Editor defaults matching the Prettier config; Prettier remains the authority
# for the files it formats
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# trailing spaces are hard line breaks in Markdown
trim_trailing_whitespace = false
